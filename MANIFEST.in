include LICENSE THIRD_PARTY_NOTICES.md README.md README.en.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include requirements.txt requirements-lock.txt package.json
recursive-include config *.example.json
recursive-include docs *.md
recursive-include sdk *.js *.mjs
recursive-include examples *.json *.mjs
recursive-include scripts *.py
recursive-include tests *.mjs
recursive-include deployment *.service
global-exclude *.pyc *.log *.sqlite* *.db *.sock *.key *.pem
exclude test-*.log smoke-private.log simulation-private.log build-private.log
